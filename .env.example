# Copy this file to ".env" and fill in the values from
# Supabase → Project Settings → API Keys (and the owner's login email).
# Without these, the site runs in local preview mode (saves in this browser only).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_OWNER_EMAIL=owner@example.com
